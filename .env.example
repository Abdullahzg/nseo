# Nseo — environment. Copy to .env.local. Only the first two blocks are needed to run the demo.

# ── Database (Supabase; free tier or `npx supabase start` locally) ────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (only for `supabase db push` / local tooling)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Nebius Token Factory (every model decision runs here) ─────────────────────
# https://tokenfactory.nebius.com → API keys. Models are NVIDIA Nemotron 3 (see src/lib/ai/models.ts).
# This is the PLATFORM key: it pays for guest demos. Signed-in owners save their own key in Settings.
NEBIUS_API_KEY=
# false = owners MUST bring their own Nebius key (the platform key then covers guest demos only)
PLATFORM_KEY_FOR_OWNERS=true
# Optional overrides — IDs exactly as GET /v1/models returns them
# NEBIUS_MODEL_ORCHESTRATOR=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_MODEL_FAST_ALT=nvidia/Nemotron-3_5-Lightning
# NEBIUS_MODEL_NEGOTIATION=nvidia/Nemotron-3-Ultra-550b-a55b
# Hard stops so a public demo cannot drain credits
NEBIUS_DAILY_TOKEN_BUDGET=2000000
NEGOTIATION_ULTRA_CAP=20
TICKS_PER_CAMPAIGN_PER_DAY=120
GUEST_MAX_TICKS=60
GUEST_CONCURRENT=2
GUEST_PER_DAY=5
GUEST_GLOBAL_PER_DAY=20

# ── Secrets ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32 — signs guest cookies and encrypts the owner's Gmail app password
AUTH_SECRET=REDACTED Bearer token the GitHub Actions scheduler sends to /api/cron/tick
CRON_SECRET=REDACTED ── Owner sign-in (optional; without it, local dev = owner, production = guests only) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any Google account is an owner (bring your own keys). To make the deployment private, list
# owner emails (comma-separated) or whole domains — then only those can sign in as owners.
OWNER_EMAILS=
ALLOWED_DOMAINS=
# Local dev without Google: which Gmail the owner is (real campaigns send from it)
DEV_OWNER_EMAIL=
APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Real mode only (demo mode needs none of these) ───────────────────────────
# Tavily web search — the runtime Tavily call for discovery (free tier: 1,000 credits/month).
# Optional platform-wide default; owners save their own in Settings. Without any Tavily key a real
# campaign still runs on the publications the owner lists at Setup.
TAVILY_API_KEY=
# Ahrefs DR (optional). Without it, authority is stored as "unverified" and scores are relevance-only.
AHREFS_API_KEY=
# Contact-finding providers (all optional; the cascade skips missing ones)
HUNTER_API_KEY=
BLITZ_API_KEY=
ENRICHSO_API_KEY=
REOON_API_KEY=
# Upstash Redis (optional): send-processor lock + Tavily key pool counters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Rendered fetch is off on Vercel (no browser binary). Leave false.
PLAYWRIGHT_ENABLED=false
# Real-mode anti-spam: initial emails per recipient domain per hour (default 3)
PER_DOMAIN_HOURLY_CAP=3

# ── Demo tuning ──────────────────────────────────────────────────────────────
# Delay before a simulated editor replies (ms). 0 = next step.
DEMO_REPLY_DELAY_MS=0
